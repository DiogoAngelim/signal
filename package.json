{
  "name": "signal-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "serialize-javascript": "7.0.5",
      "webpackbar": "7.0.0",
      "shell-quote@>=1.8.4 <1.11.0": ">=1.11.0",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9",
      "find-my-way@<=9.6.0": ">=9.7.0",
      "fastify@<5.12.5": ">=5.12.5"
    }
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "build:library": "pnpm -r --sort --filter './api/**' --filter './packages/**' --filter './server/**' run build",
    "db:migrate": "node ./server/db/scripts/migrate.mjs",
    "db:studio": "node ./server/db/scripts/studio.mjs",
    "db:check": "node ./server/db/scripts/check.mjs",
    "dev": "pnpm --filter @signal/reference-server dev",
    "dev:algai-parent-dashboard": "pnpm --filter @signal/algai-parent-dashboard dev",
    "dev:aware": "pnpm --filter @signal/aware dev",
    "dev:server": "pnpm --filter @signal/reference-server dev",
    "test": "pnpm build && pnpm -r --sort run test",
    "test:library": "pnpm build:library && pnpm -r --sort --filter './api/**' --filter './packages/**' --filter './server/**' run test",
    "coverage": "pnpm --filter @signal/agency run test:coverage && pnpm --filter @signal/decision run test:coverage && pnpm --filter @signal/decision-memory run test:coverage && pnpm --filter @signal/semantic-state run test:coverage",
    "coverage:library": "pnpm -r --sort --filter './api/**' --filter './packages/**' --filter './server/**' --if-present run test:coverage",
    "lint": "pnpm -r --sort run lint",
    "lint:library": "pnpm -r --sort --filter './api/**' --filter './packages/**' --filter './server/**' run lint",
    "arch:check": "depcruise --config .dependency-cruiser.js packages/kernel/src api/protocol/src api/ports/src api/runtime/src api/sdk-node/src api/binding-http/src server/db packages/agency/src packages/commitment/src packages/decision/src packages/decision-memory/src packages/semantic-state/src signal-cli/src",
    "verify:exports": "node ./scripts/verify-package-entrypoints.mjs",
    "proof:reference": "pnpm --filter @signal/reference-server proof",
    "proof:reference:postgres": "pnpm --filter @signal/reference-server proof:postgres",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "pnpm -r --sort run typecheck",
    "typecheck:library": "pnpm -r --sort --filter './api/**' --filter './packages/**' --filter './server/**' run typecheck",
    "clean": "pnpm -r --sort run clean",
    "release": "pnpm build && pnpm test && pnpm lint",
    "release:library": "pnpm build:library && pnpm verify:exports:library && pnpm typecheck:library && pnpm test:library && pnpm lint:library",
    "publish:all": "pnpm -r --sort --filter ./api/** --filter ./packages/** publish --access public",
    "verify": "signal verify",
    "dag:check": "node scripts/validate-dag-ts.mjs",
    "verify:exports:library": "node ./scripts/verify-package-entrypoints.mjs --library",
    "bench:runtime": "pnpm build:library && node benchmarks/runtime-dispatch.mjs",
    "bench:http": "pnpm build:library && node benchmarks/http-binding.mjs",
    "bench:postgres": "pnpm build:library && node benchmarks/prepare-postgres.mjs && node benchmarks/postgres-outbox.mjs",
    "bench:circuit-breaker": "pnpm build:library && node benchmarks/distributed-circuit-breaker.mjs",
    "bench:in-memory-circuit-breaker": "pnpm build:library && node benchmarks/in-memory-circuit-breaker.mjs",
    "bench:agency-statistics": "pnpm build:library && node benchmarks/agency-statistics.mjs",
    "bench:audit-chain": "pnpm build:library && node benchmarks/audit-chain.mjs",
    "bench:decision-pipeline": "pnpm build:library && node benchmarks/decision-pipeline.mjs",
    "bench:sustained-runtime": "pnpm build:library && node benchmarks/sustained-runtime.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.17.16",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^16.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.10",
    "vitest": "^2.1.9"
  }
}
