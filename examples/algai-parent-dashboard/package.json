{
  "name": "@signal/algai-parent-dashboard",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && pnpm run typecheck",
