{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "paths": {
      "@signal/decision": [
        "./src/typecheck-stubs/decision.d.ts"
      ],
      "@signal/commitment": [
        "./src/typecheck-stubs/commitment.d.ts"
      ],
      "@signal/semantic-state": [
        "./src/typecheck-stubs/semantic-state.d.ts"
      ],
      "@signal/sdk-node": [
        "./src/typecheck-stubs/sdk-node.d.ts"
      ],
      "@signal/agency": [
        "./src/typecheck-stubs/agency.d.ts"
      ]
    }
  },
  "include": [
    "src/domain.ts",
    "src/signal-app.ts",
    "src/typecheck-stubs/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test",
    "src/cli.ts",
    "src/evaluation.ts",
    "src/web.ts"
  ]
}
