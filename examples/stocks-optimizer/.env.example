NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocks_optimizer
SIGNAL_MEMORY_ENABLED=true
SIGNAL_MEMORY_PROVIDER=postgres
SIGNAL_SOURCE_ID=stocks-optimizer
SIGNAL_MEMORY_RETENTION_HOT_DAYS=30
SIGNAL_MEMORY_RETENTION_WARM_DAYS=180
SIGNAL_MEMORY_RETENTION_COLD_DAYS=365
SIGNAL_STORAGE_DRIVER=postgres
SIGNAL_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-hex
SIGNAL_API_KEY_HASH_PEPPER=replace-with-api-key-hash-pepper
SIGNAL_API_ALLOW_DEV_KEY=false
SIGNAL_BOOTSTRAP_ADMIN_KEY_PREFIX=bootstrap
SIGNAL_BOOTSTRAP_ADMIN_KEY_HASH=sha256=replace-with-hmac-hash
SIGNAL_API_CORS_ORIGINS=http://localhost:5173
SIGNAL_API_BODY_LIMIT=1mb
SIGNAL_API_RATE_LIMIT_MAX=120
SIGNAL_API_RATE_LIMIT_WINDOW_MS=60000
SIGNAL_REQUIRE_EMIT_SIGNATURE=true
SIGNAL_INGESTION_SIGNING_SECRET=replace-with-ingestion-signing-secret
SIGNAL_SIGNATURE_TOLERANCE_MS=300000
SIGNAL_QUEUE_MAX_DEPTH=10000
SIGNAL_QUEUE_WORKER_BATCH_SIZE=10
SIGNAL_QUEUE_WORKER_POLL_MS=1000
SIGNAL_WEBHOOK_MAX_ATTEMPTS=5
SIGNAL_WEBHOOK_RETRY_BASE_MS=500
SIGNAL_WEBHOOK_TIMEOUT_MS=5000
SIGNAL_WEBHOOK_RESPONSE_MAX_BYTES=65536
SIGNAL_WEBHOOK_REDIRECT_LIMIT=3
SIGNAL_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
SIGNAL_STREAM_HEARTBEAT_MS=15000
SIGNAL_STREAM_MAX_CLIENTS=1000
SIGNAL_STREAM_WRITE_TIMEOUT_MS=2000
SIGNAL_BACKUP_POLICY_URL=https://runbooks.example.com/stocks-optimizer/backups
