function overridePromotionGatesForBlockers(gates: any[], summary: any) {
  if (!Array.isArray(gates)) return gates;

  const blocked = hasValidationBlockersForGateDisplay(summary);
  if (!blocked) return gates;

  return gates.map((gate) => {
    const name = normalizeGateName(gate);

    if (
      name.includes("walk-forward") ||
      name.includes("walk forward") ||
      name.includes("backtest")
    ) {
      return {
        ...gate,
        status: "Watch",
        state: "Watch",
        result: "Watch",
        passed: false,
        value: `${Number(summary?.segmentCount ?? 0)} / ${Number(summary?.minimumRequiredSegments ?? 3)} required segments`,
      };
    }

    if (
      name.includes("risk-adjusted") ||
      name.includes("sharpe") ||
      name.includes("quality")
    ) {
      return {
        ...gate,
        status: "Watch",
        state: "Watch",
        result: "Watch",
        passed: false,
        value: "Unavailable",
      };
    }

    if (
      name.includes("drawdown")
    ) {
      return {
        ...gate,
        status: "Watch",
        state: "Watch",
        result: "Watch",
        passed: false,
        value: "Unavailable",
      };
    }

    if (
      name.includes("benchmark")
    ) {
      return {
        ...gate,
        status: "Watch",
        state: "Watch",
        result: "Watch",
        passed: false,
        value: "Failed",
      };
    }

    // When validation is globally blocked, live signals are not enough to prove readiness.
    if (
      name.includes("live-engine") ||
      name.includes("live engine") ||
      name.includes("signal match") ||
      name.includes("forward")
    ) {
      return {
        ...gate,
        status: "Watch",
        state: "Watch",
        result: "Watch",
        passed: false,
      };
    }

    return gate;
  });
}

function countPassedPromotionGates(gates: any[], summary: any) {
  const overridden = overridePromotionGatesForBlockers(gates, summary);

  const passed = overridden.filter((gate) => {
