            </button>
          </div>
        </header>

        {refreshError ? (
          <div className="mb-5 flex items-center gap-3 rounded-2xl border border-amber-400/20 bg-amber-400/10 px-4 py-3 text-sm text-amber-100">
            <AlertTriangle className="h-4 w-4" />
