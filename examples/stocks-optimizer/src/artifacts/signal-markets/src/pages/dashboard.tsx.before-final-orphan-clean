  if (/NASDAQ|NYSE|AMEX|ARCA|BATS|IEX|US\b|USA/.test(normalized)) {
    return { profile: "US_LARGE_CAP", ...MARKET_EXECUTION_PRESETS.US_LARGE_CAP };
