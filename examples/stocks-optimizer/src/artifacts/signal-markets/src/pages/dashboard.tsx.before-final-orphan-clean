async function asJsonOrNull(value: any) {
  if (!value) return null;

  if (typeof value.json === "function") {
    try {
      return await value.json();
    } catch (error) {
      console.warn("Failed to parse JSON response", error);
      return null;
    }
  }

  return value;
}

async function fetchJsonOrNull(input: RequestInfo | URL, init?: RequestInit) {
  try {
    const response = await fetch(input, init);

    if (!response.ok) {
      return null;
    }

    return await response.json();
  } catch (error) {
    console.warn("Failed to fetch JSON response", error);
    return null;
  }
}



function deriveFrontendFailureFlags(summary: any) {
  const sanitized = sanitizePromotionState(summary);
  const flags = new Set<string>(
    Array.isArray(sanitized.failureFlags) ? sanitized.failureFlags : [],
  );

  if (sanitized.annualizedSharpe == null) {
    flags.add("Invalid or unavailable Sharpe");
  }

  if (Number(sanitized.segmentCount ?? 0) < 3) {
    flags.add("Insufficient walk-forward segments");
  }

  if (
    sanitized.benchmarkStatus === "Failed" ||
    sanitized.benchmarkPassed === false ||
    Number(sanitized.excessReturnPct ?? sanitized.excessReturn ?? 0) < 0
  ) {
    flags.add("Benchmark comparison failed");
  }

  if (
    Number(sanitized.tradeCount ?? 0) >= 50 &&
    (sanitized.maxDrawdownPct == null || Number(sanitized.maxDrawdownPct) <= 0)
  ) {
    flags.add("Drawdown calculation incomplete");
  }

  return Array.from(flags);
}


function derivePromotionDisplayState(summary: any) {
  const sanitized = sanitizePromotionState(summary);
  const blocked =
    sanitized.promotionBlocked === true ||
