{
  "name": "stocks-optimizer",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm --filter @workspace/signal-markets build",
    "dev": "pnpm --filter @workspace/signal-markets dev"
  },
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/signal-markets build",
  "outputDirectory": "src/artifacts/signal-markets/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/stocks/(.*)",
      "destination": "/api/stocks/$1"
    },
    {
      "source": "/signals/(.*)",
      "destination": "/api/signals/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "papaparse": "^5.5.3",
    "pg": "catalog:",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "serverless-http": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}