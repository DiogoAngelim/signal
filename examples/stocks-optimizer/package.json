{
  "name": "stocks-optimizer",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "node init && pnpm --filter @workspace/api-server build && pnpm --filter @workspace/signal-markets build",
    "dev": "node init && pnpm --filter @workspace/signal-markets dev",
    "test": "node ./scripts/run-tests.cjs",
    "lint": "pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/signal-markets typecheck",
    "typecheck": "pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/signal-markets typecheck",
    "worker:build": "pnpm --filter @workspace/binance-execution-worker build",
    "worker:dev": "pnpm --filter @workspace/binance-execution-worker dev",
    "worker:start": "pnpm --filter @workspace/binance-execution-worker start",
    "worker:typecheck": "pnpm --filter @workspace/binance-execution-worker typecheck"
  },
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/signal-markets build",
  "outputDirectory": "src/artifacts/signal-markets/dist",
  "functions": {
    "api/api-catchall.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/stocks/(.*)",
      "destination": "/api/stocks/$1"
    },
    {
      "source": "/signals/(.*)",
      "destination": "/api/signals/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "papaparse": "^5.5.3",
    "pg": "catalog:",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "^4.1.7",
    "c8": "^11.0.0",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "2.0.8",
      "body-parser": "2.4.0",
      "zod": "4.6.6",
      "tinypool": "2.1.2",
      "brace-expansion@^2.0.0": "2.1.6",
      "brace-expansion@^3.0.0": "5.0.11",
      "brace-expansion@^4.0.0": "5.0.11",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "source-map-js": "1.2.2",
      "brace-expansion@^5.0.0": "5.0.11"
    }
  }
}
