{
  "name": "stocks-optimizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm --dir src install && pnpm --dir src --filter @workspace/api-server build && pnpm --dir src --filter @workspace/signal-markets build",
    "start": "pnpm --dir src --filter @workspace/signal-markets dev",
    "install:workspace": "pnpm --dir src install",
    "dev": "pnpm --dir src --filter @workspace/signal-markets dev",
    "build:api": "pnpm --dir src --filter @workspace/api-server build",
    "build:web": "pnpm --dir src --filter @workspace/signal-markets build",
    "validate": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "dotenv-cli": "^11.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react-csv": "^2.2.2",
    "recharts": "^3.8.1"
  }
}