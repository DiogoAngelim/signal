{
  "name": "@signal/maritime-aware",
  "version": "0.1.0",
  "private": false,
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node scripts/build-vercel-api.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@signal/decision": "workspace:*",
    "@signal/decision-memory": "workspace:*",
    "@signal/runtime": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "typescript": "^5.7.3",
    "vite": "catalog:",
    "vitest": "^2.1.9"
  }
}
