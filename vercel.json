{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter stocks-optimizer build",
  "outputDirectory": "examples/stocks-optimizer/src/artifacts/signal-markets/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "examples/stocks-optimizer/src/artifacts/api-server/dist/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?path=$1"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/index.html"
    }
  ]
}
